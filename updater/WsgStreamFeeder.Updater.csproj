<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WSG Stream Feeder.Updater</AssemblyName>
    <PublishSingleFile>false</PublishSingleFile>
    <Product>WSG Stream Feeder</Product>
    <Title>WSG Stream Feeder Updater</Title>
    <Description>Installs verified WSG Stream Feeder releases and recovers interrupted updates.</Description>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../src/Updates/*.cs" Link="Updates/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
